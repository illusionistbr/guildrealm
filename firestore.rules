rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers: cargos definidos via Custom Claims (Cloud Function setAdminClaims)
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return isSignedIn() && request.auth.token.role in roles;
    }

    function isAdmin() {
      return hasRole(['super_admin', 'admin']);
    }

    function isStaff() {
      return hasRole(['super_admin', 'admin', 'moderator', 'editor', 'support']);
    }

    function isGuildOwner(guildId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/guilds/$(guildId))
          .data.ownerId == request.auth.uid;
    }

    function isGuildMember(guildId) {
      return isSignedIn() &&
        request.auth.uid in
        get(/databases/$(database)/documents/guilds/$(guildId))
          .data.memberOwnerIds;
    }

    // ============ USUARIOS ============
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() &&
        (request.auth.uid == userId || isStaff());
      allow delete: if isAdmin();
    }

    // ============ PERSONAGENS ============
    match /characters/{characterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        !(resource.data.guildId is string);
    }

    // ============ GUILDS ============
    match /guilds/{guildId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerCharacterId is string &&
        get(/databases/$(database)/documents/characters/$(request.resource.data.ownerCharacterId))
          .data.ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
        (request.resource.data.ownerId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid ||
         isStaff());
      allow delete: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ============ GRUPOS DE GUILD ============
    match /guilds/{guildId}/roles/{roleId} {
      allow read: if isSignedIn() && isGuildMember(guildId);
      allow create, update: if isSignedIn() &&
        (isGuildOwner(guildId));
      allow delete: if isSignedIn() &&
        (isGuildOwner(guildId)) &&
        !resource.data.isDefault;
    }

    match /guilds/{guildId}/presets/{presetId} {
      allow read: if isSignedIn() && isGuildMember(guildId);
      allow create, update, delete: if isSignedIn() &&
        (isGuildOwner(guildId));
    }

    match /guilds/{guildId}/groups/{groupId} {
      allow read: if isSignedIn() && isGuildMember(guildId);
      allow create: if isSignedIn() &&
        (isGuildOwner(guildId)) &&
        request.resource.data.guildId == guildId;
      allow update: if isSignedIn() &&
        (isGuildOwner(guildId));
      allow delete: if isSignedIn() &&
        (isGuildOwner(guildId));

match /members/{userId} {
        allow read: if isSignedIn() && isGuildMember(guildId);
        allow create: if isSignedIn() &&
          isGuildOwner(guildId) &&
          request.auth.uid != userId &&
          (request.resource.data.roleId is string ||
           !('roleId' in request.resource.data)) &&
          get(/databases/$(database)/documents/guilds/$(guildId)/groups/$(groupId))
            .data.memberCount <
          get(/databases/$(database)/documents/guilds/$(guildId)/groups/$(groupId))
            .data.maxPlayers;
        allow update: if isSignedIn() &&
          isGuildOwner(guildId);
        allow delete: if isSignedIn() &&
          isGuildOwner(guildId);
      }
    }

    // ============ EVENTOS DE GUILD (calendario) ============
    match /guild_events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        isGuildOwner(request.resource.data.guildId);
      allow update: if isSignedIn() &&
        (resource.data.createdBy == request.auth.uid ||
         isGuildOwner(resource.data.guildId));
      allow delete: if isSignedIn() &&
        (resource.data.createdBy == request.auth.uid ||
         isGuildOwner(resource.data.guildId));

      // Participantes do evento
      match /participants/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ============ CONTEUDO PUBLICO (leitura livre, escrita de staff) ============
    match /games/{id} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'admin', 'editor']);
    }
    match /achievements/{id} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'admin', 'editor']);
    }
    match /events/{id} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'admin', 'editor']);
    }
    match /cms_sections/{id} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'admin', 'editor']);
    }
    match /seo_settings/{id} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'admin', 'editor']);
    }
    match /translations/{id} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'admin', 'editor']);
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faq/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /premium_plans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============ MARKETPLACE ============
    match /marketplace_products/{id} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'admin']);
    }
    match /marketplace_coupons/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ============ NOTIFICACOES (somente do proprio usuario) ============
    match /notifications/{notificationId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == notificationId ||
         request.auth.token.uid == request.resource.data.uid ||
         isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() &&
        (request.resource.data.uid == request.auth.uid ||
         resource.data.uid == request.auth.uid);
      allow delete: if isSignedIn() &&
        resource.data.uid == request.auth.uid;
    }

    // ============ MODERACAO ============
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if hasRole(['super_admin', 'admin', 'moderator']);
      allow update: if hasRole(['super_admin', 'admin', 'moderator']);
      allow delete: if isAdmin();
    }

    // ============ ADMIN ============
    match /admin_roles/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isAdmin();
      allow delete: if hasRole(['super_admin']);
    }

    match /admin_permissions/{id} {
      allow read, write: if hasRole(['super_admin']);
    }

    match /admin_sessions/{sessionId} {
      allow read: if hasRole(['super_admin']);
      allow create: if isStaff();
      allow update: if hasRole(['super_admin', 'admin']);
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    match /admin_settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow create: if isStaff();
      allow read: if hasRole(['super_admin', 'admin', 'moderator']);
      allow update: if hasRole(['super_admin', 'admin']);
      allow delete: if hasRole(['super_admin']);
    }

    match /audit_log/{logId} {
      allow create: if isStaff();
      allow read: if hasRole(['super_admin', 'admin']);
      allow update, delete: if hasRole(['super_admin']);
    }

    match /platform_settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ============ NEGA TODO O RESTO ============
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

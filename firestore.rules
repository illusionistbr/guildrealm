rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers: cargos definidos via Custom Claims (Cloud Function setAdminClaims)
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return isSignedIn() && request.auth.token.role in roles;
    }

    function isAdmin() {
      return hasRole(['super_admin', 'admin']);
    }

    function isStaff() {
      return hasRole(['super_admin', 'admin', 'moderator', 'editor', 'support']);
    }

    function isGuildOwner(guildId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/guilds/$(guildId))
          .data.ownerId == request.auth.uid;
    }

    function isGuildMember(guildId) {
      return isSignedIn() &&
        request.auth.uid in
        get(/databases/$(database)/documents/guilds/$(guildId))
          .data.memberOwnerIds;
    }

    // ============ USUARIOS ============
    // Atualização pelo próprio usuário limitada aos campos do perfil;
    // campos sensíveis (email, xp, role, premium...) exigem staff.
    // Nickname (URL /profile/{nickname}) pode ser alterado UMA única vez.
    function isValidNickname(nick) {
      return nick is string
        && nick.size() >= 3
        && nick.size() <= 32
        && nick.matches('^[a-z0-9_-]{3,32}$');
    }
    function canChangeNickname() {
      return !('nicknameChanged' in resource.data)
        || resource.data.nicknameChanged == false
        || resource.data.nicknameChanged == null;
    }
    function isOwnProfileFieldUpdate() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let changingNickname = keys.hasAny(['nickname']);
      let changingFlag = keys.hasAny(['nicknameChanged']);
      let changingFlagAt = keys.hasAny(['nicknameChangedAt']);
      return ( !changingNickname
               || (canChangeNickname() && isValidNickname(request.resource.data.nickname)) )
          && !(changingFlag && !changingNickname)
          && !(changingFlagAt && !changingNickname)
          && keys.hasOnly([
               'displayName', 'bio', 'socialLinks', 'visibility',
               'photoURL', 'coverUrl', 'updatedAt',
               'nickname', 'nicknameChanged', 'nicknameChangedAt',
             ]);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() &&
        ((request.auth.uid == userId && isOwnProfileFieldUpdate()) || isStaff());
      allow delete: if isAdmin();
    }

    // Estatísticas de conquistas: contadores cumulativos (events, dkp, friends, streams)
    // Escrita apenas via Cloud Functions (awardAchievement)
    match /users/{userId}/stats/{statId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Conquistas desbloqueadas por usuário
    match /users/{userId}/achievements/{achievementId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow write: if false;
    }

    // ============ MURAL DO PERFIL ============
    // Recados no mural de um usuário. Qualquer usuário logado pode publicar,
    // reagir e comentar; autor ou dono do mural podem excluir.
    match /users/{wallId}/mural/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 500;
      allow update, delete: if isSignedIn() &&
        (resource.data.authorId == request.auth.uid ||
         request.auth.uid == wallId);

      // Uma reação por usuário (id do doc = uid do autor da reação)
      match /reactions/{reactorUid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() &&
          reactorUid == request.auth.uid &&
          request.resource.data.type is string;
        allow delete: if isSignedIn() && reactorUid == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 300;
        allow delete: if isSignedIn() &&
          (resource.data.authorId == request.auth.uid ||
           request.auth.uid == wallId);
      }
    }

    // ============ PERSONAGENS ============
    match /characters/{characterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        !(resource.data.guildId is string);
    }

    // ============ GUILDS ============
    match /guilds/{guildId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerCharacterId is string &&
        get(/databases/$(database)/documents/characters/$(request.resource.data.ownerCharacterId))
          .data.ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
        (request.resource.data.ownerId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid ||
         isStaff());
      allow delete: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ============ GRUPOS DE GUILD ============
    match /guilds/{guildId}/roles/{roleId} {
      allow read: if isSignedIn() && isGuildMember(guildId);
      allow create, update: if isSignedIn() &&
        (isGuildOwner(guildId));
      allow delete: if isSignedIn() &&
        (isGuildOwner(guildId)) &&
        !resource.data.isDefault;
    }

    match /guilds/{guildId}/ranks/{rankId} {
      allow read: if isSignedIn() && isGuildMember(guildId);
      allow create, update: if isSignedIn() &&
        (isGuildOwner(guildId));
      allow delete: if isSignedIn() &&
        (isGuildOwner(guildId)) &&
        !resource.data.isDefault;
    }

    // ============ RECRUTAMENTO ============
    // Configurações visíveis para qualquer visitante (a página pública de
    // candidatura não exige login), mas a escrita é feita exclusivamente pela
    // Cloud Function (valida permissão + sanitiza).
    match /guilds/{guildId}/settings/recruitment {
      allow read: if true;
      allow write: if false;
    }

    // Hash/salt da senha da guild: nunca exposto a clientes, apenas
    // acessível pela Cloud Function (admin SDK).
    match /guilds/{guildId}/settings/recruitmentSecret {
      allow read, write: if false;
    }

    // Webhook do Discord: visível e editável apenas pelo dono da guild
    // (a URL permite postar no canal, então não pode ser pública).
    match /guilds/{guildId}/settings/discord {
      allow read, write: if isSignedIn() && isGuildOwner(guildId);
    }

    // Candidaturas: leitura apenas para membros da guild ou para o próprio candidato.
    // Criação/edição/remoção exclusivamente pela Cloud Function (valida recrutamento
    // aberto, pertencimento e pendências).
    match /guilds/{guildId}/applications/{applicationId} {
      allow read: if isSignedIn() &&
        (isGuildMember(guildId) ||
         resource.data.applicantId == request.auth.uid);
      allow write: if false;
    }

    match /guilds/{guildId}/presets/{presetId} {
      allow read: if isSignedIn() && isGuildMember(guildId);
      allow create, update, delete: if isSignedIn() &&
        (isGuildOwner(guildId));
    }

    match /guilds/{guildId}/groups/{groupId} {
      allow read: if isSignedIn() && isGuildMember(guildId);
      allow create: if isSignedIn() &&
        (isGuildOwner(guildId)) &&
        request.resource.data.guildId == guildId;
      allow update: if isSignedIn() &&
        (isGuildOwner(guildId));
      allow delete: if isSignedIn() &&
        (isGuildOwner(guildId));

match /members/{userId} {
        allow read: if isSignedIn() && isGuildMember(guildId);
        allow create: if isSignedIn() &&
          isGuildOwner(guildId) &&
          request.auth.uid != userId &&
          (request.resource.data.roleId is string ||
           !('roleId' in request.resource.data)) &&
          get(/databases/$(database)/documents/guilds/$(guildId)/groups/$(groupId))
            .data.memberCount <
          get(/databases/$(database)/documents/guilds/$(guildId)/groups/$(groupId))
            .data.maxPlayers;
        allow update: if isSignedIn() &&
          isGuildOwner(guildId);
        allow delete: if isSignedIn() &&
          isGuildOwner(guildId);
      }
    }

    // ============ EVENTOS DE GUILD (calendario) ============
    // Leitura pública: a página pública do evento é acessada sem login (link
    // compartilhado, ex.: notificações do Discord). Criação/edição seguem
    // exigindo o dono/criador da guild.
    match /guild_events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        isGuildOwner(request.resource.data.guildId);
      allow update: if isSignedIn() &&
        (resource.data.createdBy == request.auth.uid ||
         isGuildOwner(resource.data.guildId));
      allow delete: if isSignedIn() &&
        (resource.data.createdBy == request.auth.uid ||
         isGuildOwner(resource.data.guildId));

      // Participantes do evento: lista pública (nome + data); confirmar/sair
      // exige login do próprio usuário.
      match /participants/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Código de confirmação de presença: acessível apenas pela Cloud
      // Function (valida janela/membro e gera o código; nunca exposto).
      match /attendance/{docId} {
        allow read, write: if false;
      }

      // Confirmações de presença: leitura livre para autenticados (a validação
      // de membro/código é feita inteiramente pela Cloud Function; aqui só
      // precisamos que o usuário logado possa ler seu próprio status).
      match /confirmations/{userId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ============ CONTEUDO PUBLICO (leitura livre, escrita de staff) ============
    match /games/{id} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'admin', 'editor']);
    }
    match /achievements/{id} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'admin', 'editor']);
    }
    match /events/{id} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'admin', 'editor']);
    }
    match /cms_sections/{id} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'admin', 'editor']);
    }
    match /seo_settings/{id} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'admin', 'editor']);
    }
    match /translations/{id} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'admin', 'editor']);
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faq/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /premium_plans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============ MARKETPLACE ============
    match /marketplace_products/{id} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'admin']);
    }
    match /marketplace_coupons/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ============ NOTIFICACOES (somente do proprio usuario) ============
    match /notifications/{notificationId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == notificationId ||
         request.auth.token.uid == request.resource.data.uid ||
         isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() &&
        (request.resource.data.uid == request.auth.uid ||
         resource.data.uid == request.auth.uid);
      allow delete: if isSignedIn() &&
        resource.data.uid == request.auth.uid;
    }

    // ============ MODERACAO ============
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if hasRole(['super_admin', 'admin', 'moderator']);
      allow update: if hasRole(['super_admin', 'admin', 'moderator']);
      allow delete: if isAdmin();
    }

    // ============ ADMIN ============
    match /admin_roles/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isAdmin();
      allow delete: if hasRole(['super_admin']);
    }

    match /admin_permissions/{id} {
      allow read, write: if hasRole(['super_admin']);
    }

    match /admin_sessions/{sessionId} {
      allow read: if hasRole(['super_admin']);
      allow create: if isStaff();
      allow update: if hasRole(['super_admin', 'admin']);
      allow delete: if hasRole(['super_admin', 'admin']);
    }

    match /admin_settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow create: if isStaff();
      allow read: if hasRole(['super_admin', 'admin', 'moderator']);
      allow update: if hasRole(['super_admin', 'admin']);
      allow delete: if hasRole(['super_admin']);
    }

    match /audit_log/{logId} {
      allow create: if isStaff();
      allow read: if hasRole(['super_admin', 'admin']);
      allow update, delete: if hasRole(['super_admin']);
    }

    match /platform_settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ============ ACTIVITY FEED (guild-level audit) ============
    match /guilds/{guildId}/activity/{activityId} {
      allow read: if isSignedIn() && isGuildMember(guildId);
      allow create: if false;
      allow update, delete: if false;
    }

    // ============ CONFIGURACOES DO USUARIO (app/settings) ============
    match /user_settings/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ============ ANALISES (video analysis) ============
    match /guilds/{guildId}/analysisRequests/{requestId} {
      allow read: if isSignedIn() && isGuildMember(guildId);
      allow create: if isSignedIn() && isGuildOwner(guildId);
      allow update: if isSignedIn() && isGuildOwner(guildId);
      allow delete: if isSignedIn() && isGuildOwner(guildId);

      match /submissions/{submissionId} {
        allow read: if isSignedIn() && isGuildMember(guildId);
        allow create: if isSignedIn() && isGuildMember(guildId);
        allow update: if isSignedIn() && isGuildMember(guildId);
        allow delete: if isSignedIn() && isGuildOwner(guildId);

        match /comments/{commentId} {
          allow read: if isSignedIn() && isGuildMember(guildId);
          allow create: if isSignedIn() && isGuildMember(guildId);
          allow update: if isSignedIn() && isGuildMember(guildId);
          allow delete: if isSignedIn() && isGuildOwner(guildId);
        }
      }
    }

    // ============ NEGA TODO O RESTO ============
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

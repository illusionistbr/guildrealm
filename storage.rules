rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Logos de guild: leitura pública, upload apenas para usuários logados
    match /guild-logos/{guildId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn();
    }

    // Banners de guild: leitura pública, upload apenas para usuários logados
    match /guild-banners/{guildId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() &&
        request.resource.size < 4 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn();
    }

    // Avatares de usuário: leitura pública, escrita apenas pelo próprio dono
    match /user-avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Capas de perfil: leitura pública, escrita apenas pelo próprio dono
    match /user-covers/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.size < 4 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}